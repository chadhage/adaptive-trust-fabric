{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adaptive-trust-fabric:review-record:1.0.0",
  "title": "Synthetic or authorized architecture review record",
  "description": "Documentary confidence, requirement satisfaction, execution status and authorization are separate. A verified requirement needs executed evidence for its exact scope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "synthetic", "scope", "owners", "sourceFacts", "requirements", "boundaries", "authorityGraph", "recoveryGraph", "controlApplicability", "decision", "validation"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^E[1-3]$"},
    "title": {"type": "string", "minLength": 1},
    "synthetic": {"type": "boolean"},
    "scope": {
      "type": "object",
      "required": ["kind", "description", "survivabilityTier", "outOfScope", "assumptions"],
      "properties": {
        "kind": {"enum": ["synthetic-design", "authorized-lab", "operational-review"]},
        "description": {"type": "string", "minLength": 1},
        "survivabilityTier": {"enum": ["S0", "S1", "S2", "S3", "S4"]},
        "outOfScope": {"$ref": "#/$defs/nonemptyStrings"},
        "assumptions": {"$ref": "#/$defs/nonemptyStrings"}
      },
      "additionalProperties": false
    },
    "owners": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "sourceFacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceFact"}},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "boundaries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/boundary"}},
    "authorityGraph": {
      "type": "object",
      "required": ["direction", "nodes", "edges", "indirectPaths", "forbiddenPaths"],
      "properties": {
        "direction": {"const": "from-exercises-authority-over-to"},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/authorityEdge"}},
        "indirectPaths": {"type": "array", "items": {"type": "object"}},
        "forbiddenPaths": {"$ref": "#/$defs/nonemptyStrings"}
      },
      "additionalProperties": false
    },
    "recoveryGraph": {
      "type": "object",
      "required": ["direction", "nodes", "edges", "rejectedEdgeIds", "independentAnchors", "cycles", "restorationOrder"],
      "properties": {
        "direction": {"const": "from-depends-on-to"},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/recoveryEdge"}},
        "rejectedEdgeIds": {"type": "array", "items": {"type": "string"}, "description": "Edges shown only to expose rejected alternatives/cycles; they are excluded from the selected recovery dependency graph."},
        "independentAnchors": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["nodeId", "independentOf", "remainingDependencies", "proofRequired"], "properties": {"nodeId": {"type": "string"}, "independentOf": {"$ref": "#/$defs/nonemptyStrings"}, "remainingDependencies": {"$ref": "#/$defs/nonemptyStrings"}, "proofRequired": {"type": "string", "minLength": 1}}}},
        "cycles": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "nodeIds", "status", "mitigation"], "properties": {"id": {"type": "string"}, "nodeIds": {"$ref": "#/$defs/nonemptyStrings"}, "status": {"enum": ["unresolved", "broken-by-design-not-tested", "verified-broken"]}, "mitigation": {"type": "string", "minLength": 1}}}},
        "restorationOrder": {"$ref": "#/$defs/nonemptyStrings"}
      },
      "additionalProperties": false
    },
    "controlApplicability": {"type": "array", "minItems": 26, "maxItems": 26, "items": {"$ref": "#/$defs/control"}},
    "decision": {
      "type": "object",
      "required": ["status", "selectedAlternativeId", "dimensions", "alternatives", "unmetPrerequisites", "assessmentInput", "assessmentOutput", "reconsiderWhen"],
      "properties": {
        "status": {"enum": ["provisional-not-authorized", "rejected", "approved-for-scoped-lab", "approved-for-operations"]},
        "selectedAlternativeId": {"type": "string"},
        "dimensions": {"type": "object"},
        "alternatives": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "name", "disposition", "reason", "tradeoffs"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "disposition": {"enum": ["selected-provisionally", "rejected", "deferred"]}, "reason": {"type": "string", "minLength": 1}, "tradeoffs": {"$ref": "#/$defs/nonemptyStrings"}}}},
        "unmetPrerequisites": {"$ref": "#/$defs/nonemptyStrings"},
        "assessmentInput": {"type": "object"},
        "assessmentOutput": {"type": "object"},
        "reconsiderWhen": {"$ref": "#/$defs/nonemptyStrings"}
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["overallStatus", "authorizationRef", "executedEvidenceRefs", "scenarios", "limitations"],
      "properties": {
        "overallStatus": {"enum": ["blocked-no-authorized-lab", "partial-local-synthetic-only", "failed", "passed-authorized-scope"]},
        "authorizationRef": {"type": "string"},
        "executedEvidenceRefs": {"type": "array", "items": {"type": "string"}},
        "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}},
        "limitations": {"$ref": "#/$defs/nonemptyStrings"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "nonemptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "node": {"type": "object", "required": ["id", "label", "boundary", "kind"], "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "boundary": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "sourceFact": {"type": "object", "required": ["id", "claimIds", "sourceIds", "fact", "scopeLimit", "evidence"], "properties": {"id": {"type": "string"}, "claimIds": {"$ref": "#/$defs/nonemptyStrings"}, "sourceIds": {"$ref": "#/$defs/nonemptyStrings"}, "fact": {"type": "string", "minLength": 1}, "scopeLimit": {"type": "string", "minLength": 1}, "evidence": {"type": "object", "required": ["status", "verified_on", "source_refs", "applicability", "limitations", "confidence_rationale", "operational_validation"], "properties": {"status": {"enum": ["source-verified", "derived", "unverified"]}, "verified_on": {"type": ["string", "null"]}, "source_refs": {"type": "array"}, "applicability": {"$ref": "#/$defs/nonemptyStrings"}, "limitations": {"$ref": "#/$defs/nonemptyStrings"}, "confidence_rationale": {"type": "string"}, "operational_validation": {"const": "not-performed"}}}}, "additionalProperties": false},
    "requirement": {
      "type": "object",
      "required": ["id", "text", "mandatory", "origin", "owner", "status", "acceptance", "evidenceRefs", "sourceFactRefs", "unknowns"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "mandatory": {"type": "boolean"},
        "origin": {"const": "synthetic-scenario"},
        "owner": {"type": "string", "minLength": 1},
        "status": {"enum": ["declared", "verified", "unknown", "failed"]},
        "verificationScope": {"type": "object", "required": ["kind", "function", "environmentRef", "observed"], "properties": {"kind": {"enum": ["local-synthetic-only", "authorized-lab", "operational"]}, "function": {"type": "string", "minLength": 1}, "environmentRef": {"type": "string", "minLength": 1}, "observed": {}}, "additionalProperties": false},
        "acceptance": {"$ref": "#/$defs/nonemptyStrings"},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}},
        "sourceFactRefs": {"$ref": "#/$defs/nonemptyStrings"},
        "unknowns": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "verified"}}}, "then": {"required": ["verificationScope"], "properties": {"evidenceRefs": {"minItems": 1}, "unknowns": {"maxItems": 0}}}}],
      "additionalProperties": false
    },
    "boundary": {"type": "object", "required": ["id", "type", "contains", "owner", "crossingRule", "requirementRefs"], "properties": {"id": {"type": "string"}, "type": {"enum": ["trust", "tenant", "administrative", "regulatory", "data", "network", "workload", "physical-safety"]}, "contains": {"$ref": "#/$defs/nonemptyStrings"}, "owner": {"type": "string"}, "crossingRule": {"type": "string", "minLength": 1}, "requirementRefs": {"$ref": "#/$defs/nonemptyStrings"}}, "additionalProperties": false},
    "authorityEdge": {"type": "object", "required": ["id", "from", "to", "permission", "credential", "delegation", "revocation", "boundaryCrossings", "status"], "properties": {"id": {"type": "string", "minLength": 1}, "from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "permission": {"type": "string", "minLength": 1}, "credential": {"type": "string", "minLength": 1}, "delegation": {"type": "string", "minLength": 1}, "revocation": {"type": "object", "required": ["actor", "mechanism", "latencyLimit", "residualAccess"], "properties": {"actor": {"type": "string", "minLength": 1}, "mechanism": {"type": "string", "minLength": 1}, "latencyLimit": {"type": "string", "minLength": 1}, "residualAccess": {"type": "string", "minLength": 1}}}, "boundaryCrossings": {"type": "array", "items": {"type": "string"}}, "status": {"enum": ["declared", "verified", "unknown", "failed"]}}, "additionalProperties": false},
    "recoveryEdge": {"type": "object", "required": ["id", "from", "to", "dependency", "failureEffect", "alternative"], "properties": {"id": {"type": "string", "minLength": 1}, "from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "dependency": {"type": "string", "minLength": 1}, "failureEffect": {"type": "string", "minLength": 1}, "alternative": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "control": {"type": "object", "required": ["controlId", "applicability", "rationale", "owner", "requirementRefs", "requiredEvidence", "implementationStatus"], "properties": {"controlId": {"type": "string", "pattern": "^N-(0[1-9]|1[0-9]|2[0-6])$"}, "applicability": {"enum": ["applicable", "not-applicable", "unknown"]}, "rationale": {"type": "string", "minLength": 20}, "owner": {"type": "string"}, "requirementRefs": {"$ref": "#/$defs/nonemptyStrings"}, "requiredEvidence": {"$ref": "#/$defs/nonemptyStrings"}, "implementationStatus": {"enum": ["declared-only", "not-applicable", "unknown", "verified-scoped", "failed"]}}, "additionalProperties": false},
    "scenario": {"type": "object", "required": ["id", "requirementRefs", "runbookRef", "expected", "observed", "status", "evidenceRefs", "scope"], "properties": {"id": {"type": "string"}, "requirementRefs": {"$ref": "#/$defs/nonemptyStrings"}, "runbookRef": {"type": "string"}, "expected": {"$ref": "#/$defs/nonemptyStrings"}, "observed": {"type": "array", "items": {"type": "string"}}, "status": {"enum": ["not-executed-blocked", "passed-local-synthetic-only", "failed", "passed-authorized-scope"]}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}, "scope": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  }
}
