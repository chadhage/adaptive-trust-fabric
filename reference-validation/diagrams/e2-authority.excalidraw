      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: App-managed resource identity scoped to sanitized store.\nDelegation: Transaction data owner grants store access.\nRevoke — Transaction data owner: Remove resource role, block app/store sessions and rotate if compromise warrants under separate approval.\nTiming/residual: 15-minute proposed objective. Data already copied outside the store needs independent response.",
      "originalText": "Credential: App-managed resource identity scoped to sanitized store.\nDelegation: Transaction data owner grants store access.\nRevoke — Transaction data owner: Remove resource role, block app/store sessions and rotate if compromise warrants under separate approval.\nTiming/residual: 15-minute proposed objective. Data already copied outside the store needs independent response.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
