      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Audience-bound target token plus app session subject to resource-side denial.\nDelegation: Sponsor membership plus local app reader policy; no admin action mapping.\nRevoke — Application owner: Remove reader mapping, deny subject/session and test fresh plus previously issued sessions.\nTiming/residual: 30-minute proposed objective; no real timer evidence. Previously downloaded content is not recalled by session revocation.",
      "originalText": "Credential: Audience-bound target token plus app session subject to resource-side denial.\nDelegation: Sponsor membership plus local app reader policy; no admin action mapping.\nRevoke — Application owner: Remove reader mapping, deny subject/session and test fresh plus previously issued sessions.\nTiming/residual: 30-minute proposed objective; no real timer evidence. Previously downloaded content is not recalled by session revocation.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
