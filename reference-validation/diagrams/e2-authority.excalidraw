    {
      "id": "e2-authority-E2-AE04-details",
      "type": "text",
      "x": 60,
      "y": 1767,
      "width": 1760,
      "height": 120,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
