      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Configured exact issuer/audience trust, not a shared client secret.\nDelegation: Target application/tenant owner allow-lists the cohort.\nRevoke — Transition identity and app owners: Remove inbound trust/assignment and enforce app denial for existing sessions.\nTiming/residual: 30-minute effective-denial objective; not measured. Valid target tokens/application cookies may outlive trust removal.",
      "originalText": "Credential: Configured exact issuer/audience trust, not a shared client secret.\nDelegation: Target application/tenant owner allow-lists the cohort.\nRevoke — Transition identity and app owners: Remove inbound trust/assignment and enforce app denial for existing sessions.\nTiming/residual: 30-minute effective-denial objective; not measured. Valid target tokens/application cookies may outlive trust removal.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
    },
