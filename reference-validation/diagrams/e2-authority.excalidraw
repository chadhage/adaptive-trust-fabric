      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Separate cloud admin identity with supported phishing-resistant method.\nDelegation: Transition tenant owner approves reversible scoped trust changes.\nRevoke — Transition tenant incident owner: Remove role/trust administration, revoke applicable sessions and compare baseline.\nTiming/residual: 15-minute containment objective; actual behavior untested. Previously created grants/guest assignments need graph reconciliation.",
      "originalText": "Credential: Separate cloud admin identity with supported phishing-resistant method.\nDelegation: Transition tenant owner approves reversible scoped trust changes.\nRevoke — Transition tenant incident owner: Remove role/trust administration, revoke applicable sessions and compare baseline.\nTiming/residual: 15-minute containment objective; actual behavior untested. Previously created grants/guest assignments need graph reconciliation.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
    },
