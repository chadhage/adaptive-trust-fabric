      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Home-tenant user method and signed issuer assertion.\nDelegation: Transition accepts only the named home issuer/user cohort; device/MFA claims not automatically trusted.\nRevoke — Orbit identity owner and transition app owner: Disable source user, then remove target assignment and deny resource sessions independently.\nTiming/residual: 30-minute effective-denial objective, unmeasured. Home disablement alone may leave target sessions/tokens valid.",
      "originalText": "Credential: Home-tenant user method and signed issuer assertion.\nDelegation: Transition accepts only the named home issuer/user cohort; device/MFA claims not automatically trusted.\nRevoke — Orbit identity owner and transition app owner: Disable source user, then remove target assignment and deny resource sessions independently.\nTiming/residual: 30-minute effective-denial objective, unmeasured. Home disablement alone may leave target sessions/tokens valid.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
    },
