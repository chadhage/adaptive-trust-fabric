      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Two separately controlled .onmicrosoft.com cloud-only target identities with permanent-active Global Administrator assignments and supported\nphishing-resistant methods; no Orbit guest authentication.\nDelegation: Target tenant owner pre-approves emergency custody/monitoring.\nRevoke — Independent transition incident owner: Contain compromised method/account only after preserving another verified emergency path.\nTiming/residual: Incident-specific; untested. Target Entra and management APIs still required.",
      "originalText": "Credential: Two separately controlled .onmicrosoft.com cloud-only target identities with permanent-active Global Administrator assignments and supported\nphishing-resistant methods; no Orbit guest authentication.\nDelegation: Target tenant owner pre-approves emergency custody/monitoring.\nRevoke — Independent transition incident owner: Contain compromised method/account only after preserving another verified emergency path.\nTiming/residual: Incident-specific; untested. Target Entra and management APIs still required.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
