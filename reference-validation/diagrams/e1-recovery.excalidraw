    {
      "id": "e1-recovery-limits",
      "type": "text",
      "x": 60,
      "y": 3686,
      "width": 1760,
      "height": 300,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
