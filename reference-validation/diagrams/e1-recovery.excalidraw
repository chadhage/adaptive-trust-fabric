      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Failure: Normal authentication failure can block emergency authentication.\nAlternative: E1-R-CUSTODY removes this proposed dependency; demonstrate before reliance.",
      "originalText": "Failure: Normal authentication failure can block emergency authentication.\nAlternative: E1-R-CUSTODY removes this proposed dependency; demonstrate before reliance.",
