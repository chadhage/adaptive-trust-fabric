      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Local service identity with segment/protocol/action allow-list, not a cloud token dependency.\nDelegation: Site safety and OT owners approve exact mediated commands.\nRevoke — Local OT security and safety owners: Disable mediation route/action under hazard-approved response, retaining safety interlocks.\nTiming/residual: Must be established by actual hazard-reviewed test. Legacy devices may have independent local access paths needing physical/segment controls.",
      "originalText": "Credential: Local service identity with segment/protocol/action allow-list, not a cloud token dependency.\nDelegation: Site safety and OT owners approve exact mediated commands.\nRevoke — Local OT security and safety owners: Disable mediation route/action under hazard-approved response, retaining safety interlocks.\nTiming/residual: Must be established by actual hazard-reviewed test. Legacy devices may have independent local access paths needing physical/segment controls.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
    },
