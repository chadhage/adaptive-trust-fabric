    {
      "id": "e3-authority-E3-AE07-details",
      "type": "text",
      "x": 60,
      "y": 3114,
      "width": 1760,
      "height": 120,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 58,
      "version": 1,
      "versionNonce": 157,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Independent local recovery method and known-good offline baseline.\nDelegation: Local recovery owner; requires separate safety approval.\nRevoke — Local recovery governance authority: Remove recovery role/approval; safe-stop persists until both local roles are valid.\nTiming/residual: Next modeled restart attempt; actual untested. A recovered service is not safe to run merely because cyber checks pass.",
      "originalText": "Credential: Independent local recovery method and known-good offline baseline.\nDelegation: Local recovery owner; requires separate safety approval.\nRevoke — Local recovery governance authority: Remove recovery role/approval; safe-stop persists until both local roles are valid.\nTiming/residual: Next modeled restart attempt; actual untested. A recovered service is not safe to run merely because cyber checks pass.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
    },
    {
      "id": "e3-authority-limits",
      "type": "text",
      "x": 60,
      "y": 3298,
      "width": 1760,
      "height": 180,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 59,
      "version": 1,
      "versionNonce": 158,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Forbidden authority paths:\nCentral observer/corporate IdP → local runtime or safety privilege\nLocal policy/deployment identity → safety restart approval\nLocal operator → physical actuation in the supplied model\nCloud vault/online CRL/central ITSM → mandatory local bootstrap\nOne custodian → key issuance, evidence erasure and unilateral safety restart",
      "originalText": "Forbidden authority paths:\nCentral observer/corporate IdP → local runtime or safety privilege\nLocal policy/deployment identity → safety restart approval\nLocal operator → physical actuation in the supplied model\nCloud vault/online CRL/central ITSM → mandatory local bootstrap\nOne custodian → key issuance, evidence erasure and unilateral safety restart",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
    }
