      "version": 1,
      "versionNonce": 109,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Protected local signing credential and separately enrolled operator method; fixture uses an ephemeral in-memory HMAC key only.\nDelegation: Local identity custodian enrolls/approves operators; no corporate automatic entitlement.\nRevoke — Local identity custodian: Disable local identity and record local revocation; deny sessions at local enforcement.\nTiming/residual: Proposed immediate local deny on next action; actual system timing untested. Fixture revocation is not real AD/PKI/token-service revocation.",
      "originalText": "Credential: Protected local signing credential and separately enrolled operator method; fixture uses an ephemeral in-memory HMAC key only.\nDelegation: Local identity custodian enrolls/approves operators; no corporate automatic entitlement.\nRevoke — Local identity custodian: Disable local identity and record local revocation; deny sessions at local enforcement.\nTiming/residual: Proposed immediate local deny on next action; actual system timing untested. Fixture revocation is not real AD/PKI/token-service revocation.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
    },
