      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Locally controlled safety-role approval and independent physical interlock authority; fixture is only a role flag.\nDelegation: Actual site safety governance/hazard analysis, absent from this synthetic example.\nRevoke — Local safety governance authority: Replace/withdraw safety authorization through approved local process; default is no restart.\nTiming/residual: No unsafe automatic timeout override. The model does not exercise a physical stop or safety-rated system.",
      "originalText": "Credential: Locally controlled safety-role approval and independent physical interlock authority; fixture is only a role flag.\nDelegation: Actual site safety governance/hazard analysis, absent from this synthetic example.\nRevoke — Local safety governance authority: Replace/withdraw safety authorization through approved local process; default is no restart.\nTiming/residual: No unsafe automatic timeout override. The model does not exercise a physical stop or safety-rated system.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
    },
