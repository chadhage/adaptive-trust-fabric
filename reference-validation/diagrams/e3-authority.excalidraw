    {
      "id": "e3-authority-E3-AE01-details",
      "type": "text",
      "x": 60,
      "y": 505,
      "width": 1760,
      "height": 120,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
