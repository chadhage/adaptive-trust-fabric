    {
      "id": "e3-authority-E3-AE04-details",
      "type": "text",
      "x": 60,
      "y": 1792,
      "width": 1760,
      "height": 120,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
