      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Local audience-bound unexpired credential plus local role and approved policy version.\nDelegation: Local operations/safety owners define permitted functions.\nRevoke — Local policy/identity owners: Remove role/action mapping, revoke identity/session and verify deny.\nTiming/residual: Next modeled action; real enforcement untested. Previously observed information is not recalled; no physical action is granted.",
      "originalText": "Credential: Local audience-bound unexpired credential plus local role and approved policy version.\nDelegation: Local operations/safety owners define permitted functions.\nRevoke — Local policy/identity owners: Remove role/action mapping, revoke identity/session and verify deny.\nTiming/residual: Next modeled action; real enforcement untested. Previously observed information is not recalled; no physical action is granted.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
    },
