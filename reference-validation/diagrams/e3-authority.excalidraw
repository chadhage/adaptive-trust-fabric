      "versionNonce": 133,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Local append-only service identity; fixture stores a hash-linked in-memory array.\nDelegation: Local evidence owner defines retention, capacity and export policy.\nRevoke — Local OT security lead: Remove producer permission and preserve existing evidence/integrity anchor.\nTiming/residual: Local enforcement target; actual service untested. A hash chain without independent anchoring is not tamper-proof or durable.",
      "originalText": "Credential: Local append-only service identity; fixture stores a hash-linked in-memory array.\nDelegation: Local evidence owner defines retention, capacity and export policy.\nRevoke — Local OT security lead: Remove producer permission and preserve existing evidence/integrity anchor.\nTiming/residual: Local enforcement target; actual service untested. A hash chain without independent anchoring is not tamper-proof or durable.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
    },
