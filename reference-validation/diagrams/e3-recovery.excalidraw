    {
      "id": "e3-recovery-E3-RE09-details",
      "type": "text",
      "x": 60,
      "y": 3257,
      "width": 1760,
      "height": 60,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
