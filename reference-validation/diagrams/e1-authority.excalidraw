      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Application-managed identity scoped to EU stores.\nDelegation: EU data owner grants scoped resource access and retention/export policy.\nRevoke — EU data owner: Remove store role and app permission, block access and verify existing sessions.\nTiming/residual: 15-minute proposed objective; service-specific. Cached/exported records need separate incident handling.",
      "originalText": "Credential: Application-managed identity scoped to EU stores.\nDelegation: EU data owner grants scoped resource access and retention/export policy.\nRevoke — EU data owner: Remove store role and app permission, block access and verify existing sessions.\nTiming/residual: 15-minute proposed objective; service-specific. Cached/exported records need separate incident handling.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
