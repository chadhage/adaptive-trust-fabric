      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Permanent-active Global Administrator emergency authority; execute only\nincident-approved operations, with exceptional use monitored. This is not normal\njust-in-time elevation.",
      "originalText": "Permanent-active Global Administrator emergency authority; execute only\nincident-approved operations, with exceptional use monitored. This is not normal\njust-in-time elevation.",
