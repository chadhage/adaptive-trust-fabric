    {
      "id": "e1-authority-E1-AE09-details",
      "type": "text",
      "x": 60,
      "y": 3912,
      "width": 1760,
      "height": 120,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
