      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Dedicated connector identity with protected locally held connector material.\nDelegation: Hybrid identity owner grants connector scope, not tenant administration.\nRevoke — Hybrid identity owner: Disable connector identity and remove source scope; reconcile already synchronized identities separately.\nTiming/residual: Fictional 30-minute containment objective; unmeasured. Previously synchronized cloud credentials/objects are not removed by stopping sync.",
      "originalText": "Credential: Dedicated connector identity with protected locally held connector material.\nDelegation: Hybrid identity owner grants connector scope, not tenant administration.\nRevoke — Hybrid identity owner: Disable connector identity and remove source scope; reconcile already synchronized identities separately.\nTiming/residual: Fictional 30-minute containment objective; unmeasured. Previously synchronized cloud credentials/objects are not removed by stopping sync.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
