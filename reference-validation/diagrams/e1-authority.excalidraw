      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Phishing-resistant delegated human identity, app-scoped role.\nDelegation: App owner approves regional scope; no tenant role grant.\nRevoke — Application owner: Remove app role, invalidate app session and test region-scoped denial.\nTiming/residual: 30-minute proposed objective. No effect on previously exported data; export controls separate.",
      "originalText": "Credential: Phishing-resistant delegated human identity, app-scoped role.\nDelegation: App owner approves regional scope; no tenant role grant.\nRevoke — Application owner: Remove app role, invalidate app session and test region-scoped denial.\nTiming/residual: 30-minute proposed objective. No effect on previously exported data; export controls separate.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
