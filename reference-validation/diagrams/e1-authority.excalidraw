    {
      "id": "e1-authority-E1-AE03-details",
      "type": "text",
      "x": 60,
      "y": 1303,
      "width": 1760,
      "height": 120,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 26,
      "version": 1,
      "versionNonce": 125,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Cloud admin identity with phishing-resistant method on protected workstation.\nDelegation: Normal elevated role activation; not the emergency bootstrap.\nRevoke — Tenant security lead: Remove role, disable affected identity, revoke applicable sessions and verify resource denial.\nTiming/residual: 15-minute proposed incident objective; measured per service before reliance. Existing tokens/service state require separate verification.",
      "originalText": "Credential: Cloud admin identity with phishing-resistant method on protected workstation.\nDelegation: Normal elevated role activation; not the emergency bootstrap.\nRevoke — Tenant security lead: Remove role, disable affected identity, revoke applicable sessions and verify resource denial.\nTiming/residual: 15-minute proposed incident objective; measured per service before reliance. Existing tokens/service state require separate verification.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
    },
    {
