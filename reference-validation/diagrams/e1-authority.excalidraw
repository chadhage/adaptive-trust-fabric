    {
      "id": "e1-authority-E1-AE04-details",
      "type": "text",
      "x": 60,
      "y": 1797,
      "width": 1760,
      "height": 150,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 34,
      "version": 1,
      "versionNonce": 133,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Two cloud-only .onmicrosoft.com identities with separately controlled supported phishing-resistant emergency methods and reviewed blocking-policy\nexclusions.\nDelegation: Tenant owner pre-establishes emergency authority and offline custody.\nRevoke — Independent tenant incident authority: Contain a compromised emergency identity/method only after verifying another usable emergency path; reconcile sessions.\nTiming/residual: Incident-specific; no blanket instant revocation claim. Entra, method support and target control plane remain common dependencies.",
      "originalText": "Credential: Two cloud-only .onmicrosoft.com identities with separately controlled supported phishing-resistant emergency methods and reviewed blocking-policy\nexclusions.\nDelegation: Tenant owner pre-establishes emergency authority and offline custody.\nRevoke — Independent tenant incident authority: Contain a compromised emergency identity/method only after verifying another usable emergency path; reconcile sessions.\nTiming/residual: Incident-specific; no blanket instant revocation claim. Entra, method support and target control plane remain common dependencies.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
    },
