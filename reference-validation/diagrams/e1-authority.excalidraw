      "seed": 74,
      "version": 1,
      "versionNonce": 173,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Credential: Separately controlled key-administration identity and approved key custody.\nDelegation: Regional key authority approves rotation/recovery; exclusivity unresolved.\nRevoke — Regional key authority: Revoke key-administrator access and rotate/recover only through safety-reviewed service procedure.\nTiming/residual: Not set until E1-Q06 determination. Service availability/recovery keys and already decrypted data are not eliminated by tenant topology.",
      "originalText": "Credential: Separately controlled key-administration identity and approved key custody.\nDelegation: Regional key authority approves rotation/recovery; exclusivity unresolved.\nRevoke — Regional key authority: Revoke key-administrator access and rotate/recover only through safety-reviewed service procedure.\nTiming/residual: Not set until E1-Q06 determination. Service availability/recovery keys and already decrypted data are not eliminated by tenant topology.",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
    },
    {
      "id": "e1-authority-limits",
      "type": "text",
      "x": 60,
      "y": 4096,
      "width": 1760,
      "height": 150,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 75,
      "version": 1,
      "versionNonce": 174,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Forbidden authority paths:\nRegional app admin → tenant-wide identity/key/baseline administration\nCI workload → tenant role grants or external trusted-baseline writes\nNormal on-premises IdP or cloud-only password vault → exclusive custody of emergency methods\nEU raw telemetry → unrestricted global analyst workspace",
      "originalText": "Forbidden authority paths:\nRegional app admin → tenant-wide identity/key/baseline administration\nCI workload → tenant role grants or external trusted-baseline writes\nNormal on-premises IdP or cloud-only password vault → exclusive custody of emergency methods\nEU raw telemetry → unrestricted global analyst workspace",
      "fontSize": 12,
      "fontFamily": 2,
      "lineHeight": 2.5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false
